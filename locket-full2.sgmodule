#!name=Locket Day Du + Gold (usatalk)
#!desc=Module gop: script cau hinh + photobooth/AI (ptb.js) va script Gold RevenueCat (rc.js). Ca hai deu tren GitHub usatalk/ncaandptb cua ban.

[Script]
Locket Cau Hinh = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.*$, requires-body=true, script-path=https://cdn.jsdelivr.net/gh/usatalk/ncaandptb@main/ptb.js
Locket Gold RC = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.*$, requires-body=true, script-path=https://cdn.jsdelivr.net/gh/usatalk/ncaandptb@main/rc.js

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com, api.revenuecat.com
